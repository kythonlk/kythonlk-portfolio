---

<canvas id="matrix-canvas" class="matrix-rain"></canvas>

<script>
class MatrixRain {
    constructor() {
        this.canvas = document.getElementById('matrix-canvas');
        if (!this.canvas) return;
        
        this.ctx = this.canvas.getContext('2d');
        this.setupCanvas();
        this.initRain();
        this.animate();
        
        // Handle resize
        window.addEventListener('resize', () => this.setupCanvas());
    }
    
    setupCanvas() {
        this.canvas.width = window.innerWidth;
        this.canvas.height = window.innerHeight;
        
        this.columns = Math.floor(this.canvas.width / 20);
        this.drops = new Array(this.columns).fill(1);
    }
    
    initRain() {
        // Characters for the rain effect - mix of code symbols and Japanese katakana
        this.characters = 'アカサタナハマヤラワガザダバパイキシチニヒミリヰギジヂビピウクスツヌフムユルグズヅブプエケセテネヘメレヱゲゼデベペオコソトノホモヨロヲゴゾドボポヴッンABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%^&*(){}[]<>/\\|+=~`';
        this.fontSize = 16;
        this.ctx.font = `${this.fontSize}px 'JetBrains Mono', monospace`;
    }
    
    animate() {
        // Semi-transparent black background to create trail effect
        this.ctx.fillStyle = 'rgba(10, 10, 15, 0.05)';
        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
        
        // Set text color to neon cyan with glow effect
        this.ctx.fillStyle = '#00ffff';
        this.ctx.shadowColor = '#00ffff';
        this.ctx.shadowBlur = 10;
        
        for (let i = 0; i < this.drops.length; i++) {
            // Random character from our set
            const character = this.characters[Math.floor(Math.random() * this.characters.length)];
            
            // Draw the character
            this.ctx.fillText(character, i * 20, this.drops[i] * this.fontSize);
            
            // Reset drop to top with some randomization
            if (this.drops[i] * this.fontSize > this.canvas.height && Math.random() > 0.975) {
                this.drops[i] = 0;
            }
            
            // Increment Y position
            this.drops[i]++;
        }
        
        requestAnimationFrame(() => this.animate());
    }
}

// Initialize Matrix rain effect
function initMatrixRain() {
    new MatrixRain();
}

// Initialize when DOM is ready
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMatrixRain);
} else {
    initMatrixRain();
}

// Also initialize on Astro page load
document.addEventListener('astro:page-load', initMatrixRain);
</script>

<style>
#matrix-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: -10;
    opacity: 0.3;
}

/* Reduce effect on mobile for performance */
@media (max-width: 768px) {
    #matrix-canvas {
        opacity: 0.1;
    }
}
</style>