---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/page.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Count posts by type
const cyberSecurityPosts = posts.filter(post => post.data.postType === 'cyber-security-news');
const generalPosts = posts.filter(post => post.data.postType === 'general');
---

<Layout>
  <section class="py-12 bg-gray-900/20 text-gray-900 mt-[-120px]">
    <div class="container mx-auto px-4 md:px-6 lg:px-8 mt-[100px]">
      
      <!-- Tabs Navigation -->
      <div class="mb-8 border-b border-gray-300">
        <nav class="flex gap-2 -mb-px" role="tablist">
          <button 
            class="tab-button active px-6 py-3 text-sm font-semibold border-b-2 border-transparent hover:border-gray-300 transition-all flex"
            data-tab="all"
            role="tab"
            aria-selected="true"
          >
            All Posts
            <span class="ml-2 inline-flex items-center justify-center w-6 h-6 text-xs font-bold rounded-full bg-gray-200 text-gray-700">
              {posts.length}
            </span>
          </button>
          
          <button 
            class="tab-button px-2 py-3 text-sm font-semibold border-b-2 border-transparent hover:border-gray-300 transition-all flex"
            data-tab="cyber-security-news"
            role="tab"
            aria-selected="false"
          >
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Cyber Security
            </span>
            <span class="ml-2 inline-flex items-center justify-center w-6 h-6 text-xs font-bold rounded-full bg-emerald-100 text-emerald-800">
              {cyberSecurityPosts.length}
            </span>
          </button>
          
          <button 
            class="tab-button px-6 py-3 text-sm font-semibold border-b-2 border-transparent hover:border-gray-300 transition-all flex"
            data-tab="general"
            role="tab"
            aria-selected="false"
          >
            General
            <span class="ml-2 inline-flex items-center justify-center w-6 h-6 text-xs font-bold rounded-full bg-gray-200 text-gray-700">
              {generalPosts.length}
            </span>
          </button>
        </nav>
      </div>

      <!-- Tab Content: All Posts -->
      <div class="tab-content active" data-content="all">
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"> 
          {posts.map((post) => (
            <li class="bg-white/60 rounded-lg overflow-hidden shadow-lg hover:shadow-2xl motion-preset-blur-up transition-all duration-300">
              <a href={`/blog/${post.slug}/`}>
                <img
                  width={720}
                  height={360}
                  src={post.data.heroImage ?? '/blog-placeholder-1.jpg'}
                  alt={post.data.title}
                  class="w-full h-60 object-cover border"
                />
                <div class="p-4 space-y-2">
                  <div class="flex items-center gap-2 text-xs uppercase tracking-wide text-gray-700">
                    {post.data.postType === 'cyber-security-news' ? (
                      <span class="inline-flex items-center rounded-full border border-emerald-600/40 bg-emerald-100/70 px-2 py-1 text-[0.65rem] font-semibold text-emerald-800">
                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        cyber security news
                      </span>
                    ) : (
                      <span class="inline-flex items-center rounded-full border border-gray-600/30 bg-gray-100 px-2 py-1 text-[0.65rem] font-semibold text-gray-700">
                        general
                      </span>
                    )}
                  </div>
                  <h4 class="text-xl font-semibold">{post.data.title}</h4>
                  <p class="text-sm text-gray-600">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Tab Content: Cyber Security News -->
      <div class="tab-content hidden" data-content="cyber-security-news">
        {cyberSecurityPosts.length > 0 ? (
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {cyberSecurityPosts.map((post) => (
              <li class="bg-white/60 rounded-lg overflow-hidden shadow-lg hover:shadow-2xl motion-preset-blur-up transition-all duration-300">
                <a href={`/cyber/${post.slug}/`}>
                  <img
                    width={720}
                    height={360}
                    src={post.data.heroImage ?? '/blog-placeholder-1.jpg'}
                    alt={post.data.title}
                    class="w-full h-60 object-cover border"
                  />
                  <div class="p-4 space-y-2">
                    <div class="flex items-center gap-2 text-xs uppercase tracking-wide text-gray-700">
                      <span class="inline-flex items-center rounded-full border border-emerald-600/40 bg-emerald-100/70 px-2 py-1 text-[0.65rem] font-semibold text-emerald-800">
                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        cyber security news
                      </span>
                    </div>
                    <h4 class="text-xl font-semibold">{post.data.title}</h4>
                    <p class="text-sm text-gray-600">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="text-center py-12">
            <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <p class="text-gray-500 text-lg">No cyber security posts yet.</p>
          </div>
        )}
      </div>

      <!-- Tab Content: General -->
      <div class="tab-content hidden" data-content="general">
        {generalPosts.length > 0 ? (
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {generalPosts.map((post) => (
              <li class="bg-white/60 rounded-lg overflow-hidden shadow-lg hover:shadow-2xl motion-preset-blur-up transition-all duration-300">
                <a href={`/blog/${post.slug}/`}>
                  <img
                    width={720}
                    height={360}
                    src={post.data.heroImage ?? '/blog-placeholder-1.jpg'}
                    alt={post.data.title}
                    class="w-full h-60 object-cover border"
                  />
                  <div class="p-4 space-y-2">
                    <div class="flex items-center gap-2 text-xs uppercase tracking-wide text-gray-700">
                      <span class="inline-flex items-center rounded-full border border-gray-600/30 bg-gray-100 px-2 py-1 text-[0.65rem] font-semibold text-gray-700">
                        general
                      </span>
                    </div>
                    <h4 class="text-xl font-semibold">{post.data.title}</h4>
                    <p class="text-sm text-gray-600">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="text-center py-12">
            <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <p class="text-gray-500 text-lg">No general posts yet.</p>
          </div>
        )}
      </div>

    </div>
  </section>

  <script>
    // Tab switching functionality
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabContents = document.querySelectorAll('.tab-content');

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const targetTab = button.getAttribute('data-tab');
        
        // Remove active class from all buttons and contents
        tabButtons.forEach(btn => {
          btn.classList.remove('active', 'border-gray-900', 'text-gray-900');
          btn.setAttribute('aria-selected', 'false');
        });
        tabContents.forEach(content => {
          content.classList.remove('active');
          content.classList.add('hidden');
        });
        
        // Add active class to clicked button and corresponding content
        button.classList.add('active', 'border-gray-900', 'text-gray-900');
        button.setAttribute('aria-selected', 'true');
        
        const targetContent = document.querySelector(`[data-content="${targetTab}"]`);
        if (targetContent) {
          targetContent.classList.remove('hidden');
          targetContent.classList.add('active');
        }
      });
    });
  </script>

  <style>
    .tab-button {
      position: relative;
      color: #6b7280;
    }
    
    .tab-button.active {
      color: #111827;
      border-bottom-color: #111827 !important;
    }
    
    .tab-button:hover:not(.active) {
      color: #374151;
    }
    
    .tab-content {
      animation: fadeIn 0.3s ease-in-out;
    }
    
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</Layout>
