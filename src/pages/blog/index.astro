---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/page.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout>
  <section class="py-12 bg-gray-900/20 text-gray-900 mt-[-120px]">
    <div class="container mx-auto px-4 md:px-6 lg:px-8 mt-[100px]">
      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"> 
					{
						posts.map((post) => (
            <li class="bg-white/60 rounded-lg overflow-hidden shadow-lg hover:shadow-2xl motion-preset-blur-up">
								<a href={`/blog/${post.slug}/`}>
									<img
										width={720}
										height={360}
										src={post.data.heroImage ?? '/blog-placeholder-1.jpg'}
										alt=""
										class="w-full h-60 object-cover border"
									/>
									<div class="p-4 space-y-2">
										<div class="flex items-center gap-2 text-xs uppercase tracking-wide text-gray-700">
											{post.data.postType === 'cyber-security-news' ? (
												<span class="inline-flex items-center rounded-full border border-emerald-600/40 bg-emerald-100/70 px-2 py-1 text-[0.65rem] font-semibold text-emerald-800">
													cyber security news
												</span>
											) : (
												<span class="inline-flex items-center rounded-full border border-gray-600/30 bg-gray-100 px-2 py-1 text-[0.65rem] font-semibold text-gray-700">
													general
												</span>
											)}
										</div>
										<h4 class="text-xl">{post.data.title}</h4>
										<p>
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
        </div>
			</section>
</Layout>
