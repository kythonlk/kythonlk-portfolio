---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			@keyframes flicker {
				0%, 100% { opacity: 1; }
				50% { opacity: 0.8; }
			}

			@keyframes scan {
				0% { transform: translateY(-100%); }
				100% { transform: translateY(100vh); }
			}

			@keyframes glitch {
				0% { transform: translate(0); }
				20% { transform: translate(-2px, 2px); }
				40% { transform: translate(-2px, -2px); }
				60% { transform: translate(2px, 2px); }
				80% { transform: translate(2px, -2px); }
				100% { transform: translate(0); }
			}

			body {
				background: #0a0e27;
				background-image: 
					radial-gradient(circle at 20% 50%, rgba(0, 255, 65, 0.05) 0%, transparent 50%),
					radial-gradient(circle at 80% 80%, rgba(0, 150, 255, 0.05) 0%, transparent 50%);
				position: relative;
				overflow-x: hidden;
			}

			body::after {
				content: '';
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background-image: 
					linear-gradient(rgba(0, 255, 65, 0.03) 1px, transparent 1px),
					linear-gradient(90deg, rgba(0, 255, 65, 0.03) 1px, transparent 1px);
				background-size: 50px 50px;
				pointer-events: none;
				z-index: 1;
			}

			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				position: relative;
				z-index: 2;
			}

			.hero-image {
				width: 100%;
				position: relative;
				overflow: hidden;
			}

			.hero-image::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: linear-gradient(135deg, 
					rgba(0, 255, 65, 0.1) 0%, 
					rgba(0, 150, 255, 0.1) 100%);
				z-index: 1;
				pointer-events: none;
			}

			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 0;
				border: 2px solid #00ff41;
				box-shadow: 
					0 0 20px rgba(0, 255, 65, 0.3),
					0 0 40px rgba(0, 255, 65, 0.2),
					inset 0 0 60px rgba(0, 255, 65, 0.1);
				filter: brightness(0.9) contrast(1.1);
				position: relative;
				z-index: 0;
			}

			.content-wrapper {
				background: rgba(10, 14, 39, 0.85);
				border: 2px solid rgba(0, 255, 65, 0.3);
				box-shadow: 
					0 0 30px rgba(0, 255, 65, 0.2),
					inset 0 0 100px rgba(0, 255, 65, 0.03);
				position: relative;
			}

			.content-wrapper::before {
				content: '';
				position: absolute;
				top: -2px;
				left: -2px;
				right: -2px;
				bottom: -2px;
				background: linear-gradient(45deg, 
					transparent 30%, 
					rgba(0, 255, 65, 0.1) 50%, 
					transparent 70%);
				background-size: 200% 200%;
				animation: shimmer 3s ease-in-out infinite;
				border-radius: inherit;
				z-index: -1;
				pointer-events: none;
			}

			@keyframes shimmer {
				0% { background-position: 0% 0%; }
				50% { background-position: 100% 100%; }
				100% { background-position: 0% 0%; }
			}

			.terminal-header {
				background: rgba(0, 255, 65, 0.1);
				border-bottom: 1px solid rgba(0, 255, 65, 0.3);
				padding: 0.75rem 1rem;
				font-family: 'Courier New', monospace;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.terminal-dots {
				display: flex;
				gap: 0.5rem;
			}

			.dot {
				width: 12px;
				height: 12px;
				border-radius: 50%;
				border: 1px solid rgba(0, 255, 65, 0.5);
			}

			.dot.red { background: rgba(255, 95, 86, 0.8); }
			.dot.yellow { background: rgba(255, 189, 46, 0.8); }
			.dot.green { background: rgba(39, 201, 63, 0.8); }

			.terminal-title {
				color: #00ff41;
				font-size: 0.875rem;
				text-shadow: 0 0 10px rgba(0, 255, 65, 0.5);
				animation: flicker 3s infinite;
			}

			.title h1 {
				color: #00ff41;
				font-family: 'Courier New', monospace;
				text-shadow: 
					0 0 10px rgba(0, 255, 65, 0.8),
					0 0 20px rgba(0, 255, 65, 0.5),
					0 0 30px rgba(0, 255, 65, 0.3);
				letter-spacing: 0.05em;
				position: relative;
			}

			.title h1::before {
				content: '> ';
				color: #0096ff;
			}

			.date-tag {
				display: inline-block;
				background: rgba(0, 255, 65, 0.1);
				border: 1px solid rgba(0, 255, 65, 0.3);
				color: #00ff41;
				padding: 0.5rem 1rem;
				font-family: 'Courier New', monospace;
				font-size: 0.875rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				box-shadow: 0 0 10px rgba(0, 255, 65, 0.2);
			}

			.date-tag::before {
				content: '[';
				color: #0096ff;
				margin-right: 0.25rem;
			}

			.date-tag::after {
				content: ']';
				color: #0096ff;
				margin-left: 0.25rem;
			}

			hr {
				border: none;
				height: 1px;
				background: linear-gradient(90deg, 
					transparent 0%, 
					rgba(0, 255, 65, 0.5) 50%, 
					transparent 100%);
				margin: 2rem 0;
			}

			/* Content styling */
			article :global(p) {
				color: #c9d1d9;
				font-family: 'Courier New', monospace;
				line-height: 1.8;
				margin-bottom: 1.5rem;
			}

			article :global(h2),
			article :global(h3),
			article :global(h4) {
				color: #00ff41;
				font-family: 'Courier New', monospace;
				text-shadow: 0 0 10px rgba(0, 255, 65, 0.5);
				margin-top: 2rem;
				margin-bottom: 1rem;
			}

			article :global(h2::before) { content: '## '; color: #0096ff; }
			article :global(h3::before) { content: '### '; color: #0096ff; }
			article :global(h4::before) { content: '#### '; color: #0096ff; }

			article :global(code) {
				background: rgba(0, 255, 65, 0.1);
				border: 1px solid rgba(0, 255, 65, 0.2);
				color: #00ff41;
				padding: 0.2rem 0.4rem;
				border-radius: 3px;
				font-family: 'Courier New', monospace;
			}

			article :global(pre) {
				background: rgba(0, 0, 0, 0.5);
				border: 2px solid rgba(0, 255, 65, 0.3);
				padding: 1rem;
				border-radius: 4px;
				overflow-x: auto;
				box-shadow: 
					0 0 20px rgba(0, 255, 65, 0.2),
					inset 0 0 30px rgba(0, 255, 65, 0.05);
			}

			article :global(a) {
				color: #0096ff;
				text-decoration: none;
				border-bottom: 1px dashed rgba(0, 150, 255, 0.5);
				transition: all 0.3s ease;
			}

			article :global(a:hover) {
				color: #00ff41;
				border-bottom-color: rgba(0, 255, 65, 0.8);
				text-shadow: 0 0 5px rgba(0, 255, 65, 0.5);
			}

			article :global(blockquote) {
				border-left: 3px solid #00ff41;
				padding-left: 1rem;
				color: #8b949e;
				font-style: italic;
				background: rgba(0, 255, 65, 0.05);
				margin: 1.5rem 0;
			}

			article :global(ul),
			article :global(ol) {
				color: #c9d1d9;
				font-family: 'Courier New', monospace;
				margin-left: 2rem;
			}

			article :global(li::marker) {
				color: #00ff41;
			}

		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="py-4">
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt={title} loading="eager" />}
				</div>
				
				<div class="md:max-w-6xl md:mx-auto m-0 md:m-10 p-0 md:p-0 content-wrapper rounded-none md:rounded-lg overflow-hidden">
					<div class="terminal-header">
						<div class="terminal-dots">
							<div class="dot red"></div>
							<div class="dot yellow"></div>
							<div class="dot green"></div>
						</div>
						<span class="terminal-title">root@cybersec:~$</span>
					</div>

					<div class="p-4 md:p-10">
						<div class="title">
							<div class="text-center mb-6 md:mb-8">
								<span class="date-tag"><FormattedDate date={pubDate} /></span>
							</div>
							<h1 class="md:text-5xl text-2xl font-bold text-center mb-8 text-white md:mb-12">{title}</h1>
							<hr />
						</div>
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
